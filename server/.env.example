# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tarawing
# Required for PostgreSQL integration tests. The database name must end in
# "_test"; tests create and remove a random schema inside it.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tarawing_test

PORT=3301
NODE_ENV=development

# Set true only when you intentionally want the next boot to wipe and rebuild
# the database. NEVER true in production.
DB_REINIT=false

# Required in production — the server refuses to start with these unset
# or left at a placeholder value. Generate strong values with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_32_PLUS_RANDOM_CHARS
ADMIN_TOKEN=CHANGE_ME_SUPERADMIN_BOOTSTRAP_PASSWORD
ADMIN_USERNAME=admin

ALLOWED_ORIGIN=*

# Encrypts AI provider keys stored in PostgreSQL. Use a dedicated random value
# in production; if omitted, JWT_SECRET is used as the fallback.
SETTINGS_ENCRYPTION_KEY=

# Structured logging: text (dev default) | json (prod default)
LOG_FORMAT=text
LOG_HTTP=false
